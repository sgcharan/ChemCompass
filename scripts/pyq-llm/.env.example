# --- Local (no cloud, recommended if you have 8GB+ RAM) ---
USE_OLLAMA=1
OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# PYQ_LLM_PROVIDER=ollama

# --- Or LM Studio / local OpenAI-compatible server ---
# PYQ_LLM_PROVIDER=local
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# PYQ_LLM_MODEL=local-model
# OPENAI_API_KEY=not-needed

# --- Cloud: free Gemini ---
# GEMINI_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-2.0-flash

# --- Cloud: paid OpenAI ---
# OPENAI_API_KEY=sk-your-key-here
# PYQ_LLM_MODEL=gpt-4o-mini

# PYQ_CORPUS_DB=C:\path\to\data\pyq-corpus\corpus.sqlite

# Production (Fly/Render): comma-separated UI origins for CORS
# PYQ_CORS_ORIGINS=https://your-app.pages.dev
