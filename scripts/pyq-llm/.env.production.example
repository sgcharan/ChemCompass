# Production API (Fly.io, Render, etc.) — copy to platform secrets, not committed.

# Required for fast cloud generation (do not use Ollama on small free containers)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
PYQ_LLM_PROVIDER=gemini
USE_OLLAMA=0

# Corpus path inside Docker image (default in Dockerfile)
PYQ_CORPUS_DB=/app/data/pyq-corpus/corpus.sqlite

# Comma-separated browser origins for your static UI (Cloudflare Pages, Netlify, …)
# Example: https://chemcompass.pages.dev,https://www.yourdomain.com
PYQ_CORS_ORIGINS=https://your-app.pages.dev

# Set by Fly/Render; Dockerfile defaults to 8787
PORT=8787
